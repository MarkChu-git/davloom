{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The production Worker with metered bindings (entry.workers.ts), for quota.test.ts only. It
  // keeps apps/api/wrangler.jsonc's compatibility settings, alias, D1 migrations and Durable
  // Objects, and leaves out the Dashboard's assets, which no metered request reaches.
  "name": "davloom-quota",
  "main": "entry.workers.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@aws-sdk/xml-builder": "../../../../apps/api/node_modules/@aws-sdk/xml-builder/dist-cjs/index.js",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "davloom-quota",
      // Local runs only.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../../../packages/database/drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "STORAGE", "class_name": "StorageObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StorageObject"] }],
}
