{
  "name": "davloom",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/integration/compat"
  ],
  "type": "module",
  "scripts": {
    "check": "bun scripts/check.ts",
    "lint": "oxlint -c oxlint.json --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -p tsconfig.json && bun run --filter './apps/*' --filter './packages/*' --filter './tests/integration/compat' typecheck",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "coverage:summary": "bun scripts/coverage-summary.ts",
    "scan:deps": "bun scripts/tool.ts osv-scanner scan source --config=osv-scanner.toml --lockfile=bun.lock",
    "scan:secrets": "bun scripts/tool.ts gitleaks git --config=.gitleaks.toml --redact --no-banner --verbose",
    "scan:actionlint": "bun scripts/tool.ts actionlint -shellcheck= -pyflakes=",
    "scan:zizmor": "bun scripts/tool.ts zizmor --offline --strict-collection .",
    "build": "bun run --filter @davloom/web build && bun run --filter @davloom/api build",
    "test:compat": "bun run --filter @davloom/compat-tests test"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@astryxdesign/core": "0.7.16",
    "@types/bun": "1.4.4",
    "@vitest/coverage-istanbul": "5.1.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
