{
  "name": "@davloom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.bun.json && tsc -p tsconfig.workers.json",
    "build": "bun build src/entry.bun.ts --target=bun --outdir dist/bun && wrangler deploy --dry-run --outdir dist/workers",
    "dev:workers": "bun ../../tests/integration/compat/scripts/serve-workers.ts apps/api/wrangler.jsonc 8787",
    "dev:bun": "bun --watch src/entry.bun.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1176.0",
    "@aws-sdk/xml-builder": "3.972.43",
    "@davloom/auth": "workspace:*",
    "@davloom/core": "workspace:*",
    "@davloom/database": "workspace:*",
    "@davloom/laws": "workspace:*",
    "@davloom/storage": "workspace:*",
    "@davloom/webdav": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "effect": "4.1.4",
    "elysia": "1.4.32",
    "exact-mirror": "0.2.9",
    "file-type": "22.3.0",
    "openapi-types": "12.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "wrangler": "4.163.0"
  }
}
