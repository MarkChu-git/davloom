{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "davloom",
  "main": "src/entry.workers.ts",
  "compatibility_date": "2026-11-04",
  // Better Auth needs node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  // Plain variables set on the deployed Worker, such as DAVLOOM_URL, survive each deploy; this
  // file names none, so that local runs answer on their own address.
  "keep_vars": true,
  // The AWS SDK's XML utilities, without the browser parser that their package.json `browser`
  // field picks for a Worker: it needs DOMParser, which workerd lacks, so every S3 answer failed.
  // Their CommonJS build holds the parser written in JavaScript. The package is a direct
  // dependency of this app, at the version the SDK uses, so the path names this app's copy.
  "alias": {
    "@aws-sdk/xml-builder": "./node_modules/@aws-sdk/xml-builder/dist-cjs/index.js",
  },

  // The API and WebDAV share an origin with the Dashboard. Everything else is a static asset.
  // The root path runs the Worker too: static assets answer every method but GET and HEAD with
  // 405, and a WebDAV client given the bare address, as Finder is, sends OPTIONS and PROPFIND to
  // `/`. The Worker redirects those to /dav/ and serves GET and HEAD from ASSETS.
  "assets": {
    "directory": "../web/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api", "/api/*", "/dav", "/dav/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "davloom",
      // The project's own deployment. Local runs ignore it; a fork deploys with its own id.
      "database_id": "e10bf45c-6034-4cab-8744-a5370374fa25",
      "migrations_dir": "../../packages/database/drizzle",
    },
  ],
  // The project's own deployment answers on its custom domain as well as on workers.dev.
  "routes": [{ "pattern": "davloom.markchu.work", "custom_domain": true }],
  // One Durable Object per storage backend, on the SQLite storage that Workers Free offers.
  "durable_objects": {
    "bindings": [{ "name": "STORAGE", "class_name": "StorageObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StorageObject"] }],
}
